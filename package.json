{
  "name": "@xsynaptic/kiln",
  "version": "0.1.0",
  "description": "An agent harness that runs Claude Code in sandboxed VM slots and lands the work as reviewed pull requests",
  "keywords": [
    "agents",
    "claude-code",
    "sandbox",
    "colima",
    "beads"
  ],
  "homepage": "https://github.com/xsynaptic/kiln#readme",
  "bugs": {
    "url": "https://github.com/xsynaptic/kiln/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xsynaptic/kiln.git"
  },
  "license": "MIT",
  "author": "Alexander Synaptic <x@synapticism.com>",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "kiln": "./dist/kiln.cli.js"
  },
  "files": [
    "dist",
    "modes",
    "skills"
  ],
  "exports": {
    "./config": {
      "types": "./dist/config/config-schema.d.ts",
      "import": "./dist/config/config-schema.js"
    }
  },
  "imports": {
    "#lint/*": "./lint/*",
    "#src/*": "./src/*",
    "#support/*": "./verify/support/*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/run/*.mjs dist/run/",
    "changeset": "changeset",
    "check-models": "node verify/models/check-models.ts",
    "check": "lefthook run check",
    "fix": "lefthook run fix",
    "kiln": "node src/kiln.cli.ts",
    "knip": "knip",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "prepack": "pnpm build",
    "release": "pnpm check && changeset publish",
    "postrelease": "git push --follow-tags origin main",
    "test": "FORCE_COLOR=0 vitest run --passWithNoTests",
    "test:integration": "FORCE_COLOR=0 vitest run --passWithNoTests --config vitest.integration.config.ts"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "remeda": "^2.53.0",
    "tinyglobby": "^0.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@fast-check/vitest": "^0.5.0",
    "@types/node": "^24.19.1",
    "@typescript-eslint/rule-tester": "^8.72.0",
    "@typescript-eslint/utils": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-unicorn": "^78.0.0",
    "fallow": "~3.39.0",
    "knip": "^6.42.0",
    "lefthook": "^2.2.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
